{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Grab pipeline",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "rate(grab_attempt_total[5m])", "legendFormat": "attempts/s"},
        {"expr": "rate(grab_winner_total[5m])", "legendFormat": "winners/s"},
        {"expr": "rate(grab_redis_filtered_total[5m])", "legendFormat": "Redis filtered/s"},
        {"expr": "rate(grab_db_cas_total[5m])", "legendFormat": "DB CAS/s"},
        {"expr": "rate(grab_rate_limited_total[5m])", "legendFormat": "rate limited/s"}
      ]
    },
    {
      "id": 2,
      "title": "HTTP error ratio and latency",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": [
        {"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "unit", "value": "percentunit"}]},
        {"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [{"id": "unit", "value": "s"}]}
      ]},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count[5m])), 1)", "legendFormat": "5xx ratio"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))", "legendFormat": "HTTP p95"}
      ]
    },
    {
      "id": 3,
      "title": "Async reliability",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": [
        {"matcher": {"id": "byName", "options": "publish success/s"}, "properties": [{"id": "unit", "value": "reqps"}]},
        {"matcher": {"id": "byName", "options": "publish failure/s"}, "properties": [{"id": "unit", "value": "reqps"}]},
        {"matcher": {"id": "byName", "options": "timeout lag (s)"}, "properties": [{"id": "unit", "value": "s"}]},
        {"matcher": {"id": "byName", "options": "Redis degraded/s"}, "properties": [{"id": "unit", "value": "reqps"}]}
      ]},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "outbox_pending", "legendFormat": "Outbox pending"},
        {"expr": "outbox_dead", "legendFormat": "Outbox dead"},
        {"expr": "rate(outbox_publish_success_total[5m])", "legendFormat": "publish success/s"},
        {"expr": "rate(outbox_publish_failure_total[5m])", "legendFormat": "publish failure/s"},
        {"expr": "timeout_queue_lag_seconds", "legendFormat": "timeout lag (s)"},
        {"expr": "rate(redis_degraded_total[5m])", "legendFormat": "Redis degraded/s"}
      ]
    },
    {
      "id": 4,
      "title": "Outbox publish duration",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(outbox_publish_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95"},
        {"expr": "rate(outbox_publish_duration_seconds_sum[5m]) / clamp_min(rate(outbox_publish_duration_seconds_count[5m]), 1)", "legendFormat": "mean"}
      ]
    },
    {
      "id": 5,
      "title": "Financial reconciliation",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 18},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": [
        {"matcher": {"id": "byName", "options": "recon failures/s"}, "properties": [{"id": "unit", "value": "reqps"}]},
        {"matcher": {"id": "byName", "options": "settlement retries/s"}, "properties": [{"id": "unit", "value": "reqps"}]},
        {"matcher": {"id": "byName", "options": "last success timestamp"}, "properties": [{"id": "unit", "value": "dateTimeAsIso"}]}
      ]},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "rate(recon_failure_total[5m])", "legendFormat": "recon failures/s"},
        {"expr": "rate(settlement_retry_total[5m])", "legendFormat": "settlement retries/s"},
        {"expr": "settlement_dead", "legendFormat": "settlement dead"},
        {"expr": "recon_last_success_timestamp", "legendFormat": "last success timestamp"}
      ]
    },
    {
      "id": 6,
      "title": "Redis degradation",
      "type": "stat",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 18},
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value"},
      "targets": [
        {"expr": "increase(redis_degraded_total[15m])", "legendFormat": "degraded operations in 15m"}
      ]
    }
  ],
  "schemaVersion": 39,
  "time": {"from": "now-1h", "to": "now"},
  "title": "Campus Errand Reliability",
  "version": 2
}
